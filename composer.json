{
    "require": {
        "php": "^8.4",
        "ext-ctype": "*",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "backslashphp/backslash": "^2.2",
        "psr/container": "^2",
        "ramsey/uuid": "^4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3",
        "phpunit/phpunit": "^12",
        "squizlabs/php_codesniffer": "^3"
    },
    "autoload": {
        "psr-4": {
            "Demo\\": "src/"
        }
    },
    "scripts": {
        "format": "php-cs-fixer fix",
        "test": "phpunit"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    }
}
