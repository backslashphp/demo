{
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-pdo": "*",
        "backslashphp/backslash": "2.x-dev",
        "psr/container": "^2",
        "ramsey/uuid": "^4"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "friendsofphp/php-cs-fixer": "^3",
        "phpunit/phpunit": "^8 || ^9",
        "squizlabs/php_codesniffer": "^3"
    },
    "autoload-dev": {
        "psr-4": {
            "Demo\\": "src/",
            "Demo\\Test\\": "tests/"
        }
    },
    "scripts": {
        "format": "php-cs-fixer fix",
        "test": "phpunit"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    }
}
